# Dependencies
# pnpm-lock.yaml is deliberately absent from this file: it is committed
# and is what pins every package to an exact version and hash.
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest-cache/

# Runtime
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example

# mise local overrides (the committed .mise.toml is the shared config)
.mise.local.toml
mise.local.toml
.mise/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating systems
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Claude
# `.claude/` itself is tracked on purpose — settings.json is shared
# config. Only per-user state and scratch worktrees are ignored.
.claude/settings.local.json
.claude/worktrees
